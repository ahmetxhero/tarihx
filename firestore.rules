rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles: Users can only read and update their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default catch-all rule: Deny writes by default, allow authenticated reads
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
